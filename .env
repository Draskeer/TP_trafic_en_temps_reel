# ─── Réglages de la démo (le "temps" est accéléré pour tenir en présentation) ───

# Accélération : 1 seconde réelle = SPEEDUP secondes "de la simulation".
# Avec 10, une fenêtre d'1 minute (event-time) se ferme toutes les ~6 s réelles.
SPEEDUP=10

# Période réelle (en s) entre deux rafraîchissements du simulateur.
TICK_REAL=0.2

# Intervalle (en secondes event-time) entre deux points GPS envoyés par voiture.
PROBE_INTERVAL_S=3

# Taille de la fenêtre de calcul, en secondes event-time (l'énoncé : 1 minute).
WINDOW_S=60

# Retard toléré par le watermark, en secondes event-time.
# Le compromis central : court = rapide mais incomplet, long = complet mais lent.
WATERMARK_DELAY_S=30

# À la sortie du tunnel, délai de reconnexion tiré entre 0 et cette valeur (s event-time).
TUNNEL_RECONNECT_MAX_S=60

# Part de points GPS aberrants, dans le tunnel et dans le reste de la ville.
GPS_ERROR_TUNNEL=0.25
GPS_ERROR_CITY=0.02

# Filtres de Flink : au-delà, un point est rejeté.
MAX_SPEED_KMH=130
MAX_ROAD_DIST=200

# Intervalle (en ms réelles) entre deux checkpoints de Flink.
CHECKPOINT_INTERVAL_MS=5000

# Nombre de voitures au démarrage, et maximum du curseur de l'interface.
N_CARS=50
MAX_CARS=300
